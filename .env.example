# Copia este archivo a ".env" y rellena tu propia clave.
# El archivo ".env" NO debe subirse nunca a git (ya está en .gitignore).

# API de Anthropic, para buscar palabras, leer fotos de apuntes y generar frases.
# Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Código que hay que escribir para poder crear una cuenta nueva. Vacío =
# cualquiera puede registrarse (cómodo en local). Ponle algo antes de
# compartir la app fuera de tu red, y pásaselo solo a quien quieras invitar.
SIGNUP_INVITE_CODE=
